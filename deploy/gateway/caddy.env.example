# Install a filled copy at /etc/caddy/trial.env, owned root:caddy, mode 0640.
# Caddy unit drop-in: EnvironmentFile=/etc/caddy/trial.env
# This host is a single DNS name, without scheme, port, wildcard or path.
TRIAL_HOST='trial.example.com'
# Generate a DIFFERENT password hash per user using `caddy hash-password`.
# Intentional blanks: complete the protected copy before validating/starting.
# Keep single quotes around bcrypt hashes so a Bash import preserves '$'.
TRIAL_ADMIN_HASH=''
TRIAL_INVITEE_01_HASH=''
